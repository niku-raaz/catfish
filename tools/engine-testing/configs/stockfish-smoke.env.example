# Fastchess Stockfish smoke (wiring only)
#
# Depth 4 vs depth 4 is not equal computation. Use this only to verify UCI
# plumbing: legal moves, clean quit, PGN output, and no hangs.
#
# Required environment:
#   STOCKFISH   absolute path to a pinned Stockfish binary
# Optional:
#   CATFISH_UCI / CATFISH_ENGINE_PATH
#   OPENINGS    absolute path to an EPD suite (default: local smoke openings)
#   FASTCHESS
#   ENGINE_TESTING_SEED

catfish_cmd: ${CATFISH_UCI}
stockfish_cmd: ${STOCKFISH}
openings_file: ${OPENINGS}
seed: ${ENGINE_TESTING_SEED}
depth: 4
hash_mb: 32
rounds: 20
concurrency: 1
pgn_out: results/stockfish-smoke.pgn
