{
  "name": "catfish-chess",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:engine": "cmake --preset debug && cmake --build --preset debug",
    "build:engine:release": "cmake --preset release && cmake --build --preset release",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:engine && npm run typecheck && npm run build:web && npm run build:server",
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist-server/server/index.js",
    "docker:build": "docker build --tag catfish-chess:local .",
    "docker:up": "docker compose up --build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint web server e2e vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:uci-process": "node tools/engine-testing/scripts/uci-process-test.mjs",
    "test:uci-compliance": "node tools/engine-testing/scripts/run-compliance.mjs",
    "test:engine-smoke": "node tools/engine-testing/scripts/run-stockfish-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "dotenv": "^17.2.1",
    "express": "5.2.1",
    "react": "19.2.8",
    "react-chessboard": "5.10.0",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "10.8.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
