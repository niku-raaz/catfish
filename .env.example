# Copy to .env for local overrides. Do not commit .env.
CATFISH_ENGINE_PATH=build/debug/catfish_uci
CATFISH_HOST=127.0.0.1
CATFISH_PORT=8787
CATFISH_HASH_MB=32
CATFISH_MAX_PENDING_SEARCHES=8
CATFISH_RATE_LIMIT_MAX=60
CATFISH_RATE_LIMIT_WINDOW_MS=60000

# Optional trusted engine configuration
# CATFISH_OWN_BOOK=true
# CATFISH_BOOK_PATH=/absolute/path/to/openings.tsv
# CATFISH_SYZYGY_PATH=/absolute/path/to/syzygy
